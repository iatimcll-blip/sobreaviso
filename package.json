{
  "name": "painel-sobreaviso",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --env-file=.env scripts/dev-server.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "seed:dev": "tsx --env-file=.env scripts/seed-dev.ts",
    "build": "vite build && node scripts/build-api.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.0",
    "@vitejs/plugin-react": "6.0.5",
    "hono": "4.13.2",
    "lucide-react": "1.31.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "xlsx": "0.18.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true
  }
}
